<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Fanasa.SSO</id>
    <version>1.1.0</version>
    <authors>Fanasa</authors>
    <description>SDK de autenticación SSO Fanasa para Microsoft Entra ID. Compatible con .NET 4.0 a .NET 8, ASP.NET MVC, Web Forms, Blazor y APIs REST.</description>
    <tags>sso authentication azure entra-id fanasa aspnet aspnetcore mvc webforms blazor</tags>
    <repository type="git" commit="45752ba7ecae9ae04ed9cbc9fc3f7c4233340398" />
    <dependencies>
      <group targetFramework=".NETFramework4.0" />
      <group targetFramework=".NETFramework4.5">
        <dependency id="System.IdentityModel.Tokens.Jwt" version="5.7.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Microsoft.AspNetCore.Authentication.JwtBearer" version="6.0.36" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Web" version="1.25.3" exclude="Build,Analyzers" />
        <dependency id="System.IdentityModel.Tokens.Jwt" version="6.35.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.AspNetCore.Authentication.JwtBearer" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Identity.Web" version="2.18.1" exclude="Build,Analyzers" />
        <dependency id="System.IdentityModel.Tokens.Jwt" version="7.5.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Web" targetFramework=".NETFramework4.0, .NETFramework4.5" />
      <frameworkAssembly assemblyName="System.Web.Extensions" targetFramework=".NETFramework4.0, .NETFramework4.5" />
      <frameworkAssembly assemblyName="System.DirectoryServices" targetFramework=".NETFramework4.5" />
    </frameworkAssemblies>
  </metadata>
</package>