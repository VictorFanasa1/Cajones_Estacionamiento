<?xml version="1.0" encoding="utf-8"?>
<!-- Copia este archivo como Secrets.config (no se sube a git) y llena los valores.
     Se carga desde Web.config: <appSettings file="Secrets.config">
     Si cambias este archivo, reinicia la app (IIS/IIS Express) para que lo tome. -->
<appSettings>
  <!-- Cuenta de servicio para consultar AD en el login SSO -->
  <add key="LdapServiceUser" value="" />
  <add key="LdapServicePassword" value="" />
</appSettings>
