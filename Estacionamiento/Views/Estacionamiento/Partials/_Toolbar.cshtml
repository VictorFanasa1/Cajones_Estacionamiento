@* Toolbar superior con acceso a Asignación *@
<div class="row" style="margin:15px 0;">
  <div class="col-md-12 text-right">
    <a class="btn btn-primary" href="@Url.Action("AsignacionLugares", "Estacionamiento")">
      <span class="glyphicon glyphicon-list-alt"></span> Asignación de Lugares
        <p>dsadsadasdasdasdasdsadasdasdsa</p>
    </a>
    @if (User.IsInRole("Administrador"))
    {
        <p>dsadsadasdasdasdasdsadasdasdsa</p>
      <a class="btn btn-success" href="@Url.Action("DescargarAuditoria", "Reportes")"
        title="Descargar auditoría (últimos 30 días)">
        <span class="glyphicon glyphicon-download"></span> Auditoría (CSV)
      </a>
      <button type="button" class="btn btn-danger" id="btnLiberarDiario" title="Liberar cajones de visitantes (manual)">
        <span class="glyphicon glyphicon-time"></span> Liberar cajones (hoy)
      </button>
    }
  </div>
  <div class="clearfix"></div>
  <hr style="margin-top:10px;margin-bottom:20px;" />
</div>

<script type="text/javascript">
  (function () {
    var btn = document.getElementById('btnLiberarDiario');
    if (!btn) return;
    btn.addEventListener('click', function () {
      if (typeof alertify !== 'undefined') {
        var confirmDlg = alertify.confirm('Liberar cajones', '¿Ejecutar liberación de cajones de visitantes del día?', null, null)
          .set('labels', { ok: 'Confirmar', cancel: 'Cancelar' })
          .set({ transition: 'slide' })
          .set('onok', function () {
            fetch('@Url.Action("LiberarCajonesDiarios_AJAX", "Estacionamiento")', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json;charset=utf-8' }
            }).then(function (r) { return r.json(); })
              .then(function (r) {
                if (r && r.error) { alertify.alert('Error', r.mensaje || 'Error al liberar cajones'); }
                else { alertify.success('Liberación ejecutada'); }
              }).catch(function (err) { alert(err); });
          });
      } else {
        if (!confirm('¿Ejecutar liberación de cajones de visitantes del día?')) return;
        fetch('@Url.Action("LiberarCajonesDiarios_AJAX", "Estacionamiento")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json;charset=utf-8' }
        }).then(function (r) { return r.json(); })
          .then(function (r) {
            if (r && r.error) { alert(r.mensaje || 'Error al liberar cajones'); }
            else { alert('Liberación ejecutada'); }
          }).catch(function (err) { alert(err); });
      }
    });
  })();
</script>