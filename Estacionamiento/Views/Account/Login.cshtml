@model Estacionamiento.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ssoEnabled = string.Equals(System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
    // ?local=1 muestra el login tradicional (oculto, solo para pruebas)
    var modoLocal = Request.QueryString["local"] == "1";
    // Solo se redirige al SSO en GET; si el formulario tradicional regresó con error, se muestra el error
    var ssoAuto = ssoEnabled && !modoLocal && Request.HttpMethod == "GET";
    // El formulario tradicional solo se ve sin SSO, con ?local=1 o al regresar de un POST con error
    var mostrarFormulario = !ssoEnabled || modoLocal || Request.HttpMethod == "POST";
}

<div class="row login-page" style="margin-top:30px;">
    <div class="col-sm-8 col-md-4 col-md-offset-4 col-sm-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title text-center">@ViewBag.Title</h3>
            </div>
            <div class="panel-body">

                @if (ssoAuto)
                {
                    <div id="sso-cargando" class="text-center" style="padding:15px 0;">
                        <p><i class="fa fa-spinner fa-spin"></i> Iniciando sesión con tu cuenta de Microsoft...</p>
                    </div>
                }
                <div id="sso-error" style="display:none;">
                    <div class="alert alert-danger" id="sso-error-msg"></div>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-block">Intentar de nuevo</a>
                </div>

                <div id="login-local" style="@(mostrarFormulario ? "" : "display:none;")">
                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                  @*   <div class="login-fields"> *@
                    <div class="form-group">
                        @Html.LabelFor(m => m.Usuario)
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-user"></i></span>
                            @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "usuario", autofocus = "autofocus" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Password)
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Contraseña" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                   @*  </div> *@

                    @Html.HiddenFor(m => m.ReturnUrl)
                    <p class="text-muted" style="margin-bottom:15px;">
                        Utiliza tu username y contraseña institucional para acceder.
                    </p>
                    <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                }

                @if (ssoEnabled)
                {
                    <p class="text-center" style="margin-top:15px;">
                        <a href="@Url.Action("Login", "Account")"><i class="fa fa-windows"></i> Entrar con tu cuenta de Microsoft</a>
                    </p>
                }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (ssoEnabled)
    {
        <script src="@Url.Content("~/fanasa-sso/script")"></script>
        <script>
            (function () {
                var ssoAuto = @(ssoAuto ? "true" : "false");

                var sso = new FanasaSSO({
                    ssoUrl: '@System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:SsoUrl"]',
                    redirectUri: window.location.origin + '@Url.Action("Login", "Account")',
                    clientName: '@System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:ClientName"]'
                });

                function mostrarError(msg) {
                    $('#sso-cargando').hide();
                    $('#sso-error-msg').text(msg);
                    $('#sso-error').show();
                }

                // Regreso del SSO: el token viene en el hash (#id_token=...), nunca llega al servidor en la URL
                var token = sso.handleRedirectCallback();
                if (token) {
                    $.post('@Url.Action("LoginSso", "Account")', {
                        idToken: token.idToken,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    }).done(function (r) {
                        if (r && r.ok) { window.location = r.redirect; }
                        else { mostrarError((r && r.message) || 'No se pudo iniciar sesión.'); }
                    }).fail(function () {
                        mostrarError('Error de comunicación con el servidor.');
                    });
                    return;
                }

                // Sin token: ir al SSO. Si ya hay sesión de Microsoft, regresa de inmediato sin pedir nada
                if (ssoAuto) {
                    sso.loginRedirect();
                }
            })();
        </script>
    }
}
