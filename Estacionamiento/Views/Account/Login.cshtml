@model Estacionamiento.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ssoEnabled = string.Equals(System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
}

<div class="row login-page" style="margin-top:30px;">
    <div class="col-sm-8 col-md-4 col-md-offset-4 col-sm-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title text-center">@ViewBag.Title</h3>
            </div>
            <div class="panel-body">
              
                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                  @*   <div class="login-fields"> *@
                    <div class="form-group">
                        @Html.LabelFor(m => m.Usuario)
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-user"></i></span>
                            @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "usuario", autofocus = "autofocus" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Password)
                        <div class="input-group">
                            <span class="input-group-addon"><i class="fa fa-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Contraseña" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                   @*  </div> *@

                    @Html.HiddenFor(m => m.ReturnUrl)
                    <p class="text-muted" style="margin-bottom:15px;">
                        Utiliza tu username y contraseña institucional para acceder.
                    </p>
                    <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                }

                @if (ssoEnabled)
                {
                    <div class="text-center text-muted" style="margin:15px 0;">— o —</div>
                    <div id="sso-error" class="alert alert-danger" style="display:none;"></div>
                    <button type="button" id="btn-sso" class="btn btn-default btn-block">
                        <i class="fa fa-windows"></i> Iniciar sesión con Microsoft
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @if (ssoEnabled)
    {
        <script src="@Url.Content("~/fanasa-sso/script")"></script>
        <script>
            (function () {
                var $btn = $('#btn-sso');
                var $err = $('#sso-error');
                var textoOriginal = $btn.html();

                function mostrarError(msg) {
                    $err.text(msg).show();
                    $btn.prop('disabled', false).html(textoOriginal);
                }

                $btn.on('click', function () {
                    $err.hide();
                    $btn.prop('disabled', true).text('Conectando con Microsoft...');

                    var sso = new FanasaSSO({
                        ssoUrl: '@System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:SsoUrl"]',
                        redirectUri: window.location.origin + '@Url.Content("~/")',
                        clientName: '@System.Configuration.ConfigurationManager.AppSettings["FanasaSSO:ClientName"]'
                    });

                    sso.loginPopup().then(function (token) {
                        $.post('@Url.Action("LoginSso", "Account")', {
                            idToken: token.idToken,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        }).done(function (r) {
                            if (r && r.ok) { window.location = r.redirect; }
                            else { mostrarError((r && r.message) || 'No se pudo iniciar sesión.'); }
                        }).fail(function () {
                            mostrarError('Error de comunicación con el servidor.');
                        });
                    }, function (e) {
                        mostrarError(e && e.message ? e.message : 'No se pudo iniciar sesión con Microsoft.');
                    });
                });
            })();
        </script>
    }
}
