<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/estacionamiento.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <link href="~/alertifyjs/css/alertify.css" rel="stylesheet" />
    <link href="~/alertifyjs/css/themes/default.min.css" rel="stylesheet" />
    <link href="~/FontAwesome/css/all.css" rel="stylesheet" />
    @* Estilos del header movidos a ~/Content/estacionamiento.css *@
</head>

<body>
    <div class="navbar navbar-inverse navbar-fixed-top"
        style="background:-webkit-linear-gradient(#7FB3D5 ,#2471A3); border-color:white">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @*@Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })*@
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav"></ul>
                @if (ViewBag.HideAuthHeader != true)
                {
                    <ul class="nav navbar-nav navbar-right">
                        @if (Request.IsAuthenticated)
                        {
                            <li class="navbar-text nav-user"><span class="glyphicon glyphicon-user"></span> 
                              <b style="color:white">Hola, @User.Identity.Name</b> </li>
                            <li>
                                <a href="@Url.Action("Logout", "Account")" class="btn btn-logout navbar-btn" style="color:white">
                                    <span class="glyphicon glyphicon-log-out" style="color:white"></span> <b style="color:white">Cerrar sesión</b> 
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>@Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "nav-link" })</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="container body-content">
        @RenderBody()
        @*<hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>*@
    </div>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @if (Request.IsAuthenticated)
    {
        <script>
            // Redirige a Logout tras expirar la sesión
            var minutes = @Session.Timeout;
            var sTimeout = parseInt(minutes) * 60 * 1000; // minutos a ms
            setTimeout(function () {
                window.location = '@Url.Action("Logout", "Account")';
            }, sTimeout);
        </script>
    }
    @RenderSection("scripts", required: false)
</body>

</html>